{
  "name": "newgate-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && node scripts/verify-dist.js && rm -rf android/app/src/main/assets/public && mkdir -p android/app/src/main/assets/public && cp -R dist/. android/app/src/main/assets/public/. && npx cap sync android && node scripts/verify-assets.js",
    "lint": "tsc --noEmit",
    "verify:production": "node scripts/verify-production.js",
    "verify:workflows": "node scripts/verify-workflows.js",
    "verify:e2e-matrix": "node scripts/verify-e2e-matrix.js",
    "build:targets": "vite build --outDir dist-targets",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^1.30.0",
    "lucide-react": "^0.555.0",
    "motion": "^12.38.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
